{
    "name": "@dpuse/dpuse-development",
    "version": "1.0.123",
    "private": false,
    "description": "Actions for managing DPUse projects.",
    "license": "MIT",
    "author": "Jonathan Terrell <terrell.jm@gmail.com>",
    "type": "module",
    "sideEffects": false,
    "homepage": "https://www.dpuse.app",
    "bugs": {
        "url": "https://github.com/dpuse/dpuse-development/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dpuse/dpuse-development.git"
    },
    "module": "./dist/dpuse-development.es.js",
    "types": "./dist/types/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/src/index.d.ts",
            "import": "./dist/dpuse-development.es.js"
        },
        "./prettierrc": "./.prettierrc.json",
        "./vite": {
            "types": "./dist/types/src/vite.d.ts",
            "import": "./dist/vite.es.js"
        }
    },
    "files": [
        ".editorconfig",
        ".gitattributes",
        ".github/dependabot.private.rust.yml",
        ".github/dependabot.private.yml",
        ".github/dependabot.rust.yml",
        ".github/dependabot.yml",
        ".github/workflows",
        ".gitignore_default",
        ".markdownlint.json",
        ".ncurc.json",
        ".prettierrc.json",
        "dist",
        "eslint.config.default.js",
        "LICENSE",
        "rust-toolchain.toml",
        "scripts/tsconfig.json",
        "SECURITY.md",
        "tsconfig.json",
        "vite.config.default.ts",
        "vite.config.presenter.ts",
        "vite.config.tool.ts",
        "vitest.config.ts"
    ],
    "engines": {
        "node": ">=24",
        "npm": ">=12"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=12",
            "onFail": "error"
        }
    },
    "allowScripts": {
        "fsevents@2.3.3": true,
        "unrs-resolver@1.11.1": true
    },
    "scripts": {
        "audit": "node -e \"import('./dist/dpuse-development.es.js').then(m => m.auditDependencies())\"",
        "build": "vite build",
        "check": "node -e \"import('./dist/dpuse-development.es.js').then(m => m.checkProject())\"",
        "document": "node -e \"import('./dist/dpuse-development.es.js').then(m => m.documentProject(''))\"",
        "format": "node -e \"import('./dist/dpuse-development.es.js').then(m => m.formatCode())\"",
        "lint": "node -e \"import('./dist/dpuse-development.es.js').then(m => m.lintCode())\"",
        "release": "npm run build && npm run document && npm run sync && node -e \"import('./dist/dpuse-development.es.js').then(m => m.triggerGitHubRelease())\"",
        "sync": "node -e \"import('./dist/dpuse-development.es.js').then(m => m.syncProjectWithGitHub())\"",
        "test": "node -e \"import('./dist/dpuse-development.es.js').then(m => m.testProject())\""
    },
    "peerDependencies": {
        "typescript": "^6.0.3"
    },
    "peerDependenciesMeta": {
        "typescript": {
            "optional": true
        }
    },
    "dependencies": {
        "@dpuse/dpuse-shared": "^1.0.116",
        "license-checker-rseidelsohn": "^5.0.1",
        "npm-check-updates": "^23.1.0",
        "spdx-satisfies": "^6.0.0",
        "valibot": "^1.5.0"
    },
    "devDependencies": {
        "@dpuse/eslint-config-dpuse": "^1.0.132",
        "@types/node": "^26.6.4",
        "@types/spdx-satisfies": "^6.0.0",
        "@vitest/coverage-v8": "^5.0.3",
        "eslint": "^10.12.0",
        "fallow": "^3.32.0",
        "fast-check": "^4.10.2",
        "prettier": "^3.9.9",
        "sonda": "^0.14.0",
        "type-fest": "^5.10.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.3",
        "vite-plugin-dts": "^5.1.2",
        "vitest": "^5.0.3"
    }
}
