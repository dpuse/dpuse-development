{
    "name": "@dpuse/dpuse-development",
    "version": "0.3.770",
    "private": false,
    "description": "Actions for managing DPUse projects.",
    "license": "MIT",
    "author": "Jonathan Terrell <terrell.jm@gmail.com>",
    "type": "module",
    "sideEffects": false,
    "homepage": "https://www.dpuse.app",
    "bugs": {
        "url": "https://github.com/dpuse/dpuse-development/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dpuse/dpuse-development.git"
    },
    "module": "./dist/dpuse-development.es.js",
    "types": "./dist/types/src/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/dpuse-development.es.js",
            "types": "./dist/types/src/index.d.ts"
        },
        "./prettierrc": "./.prettierrc.json"
    },
    "files": [
        ".editorconfig",
        ".gitattributes",
        ".github/dependabot.private.yml",
        ".github/dependabot.yml",
        ".github/publish.cloudflare.yml",
        ".github/workflows",
        ".gitignore_default",
        ".markdownlint.json",
        ".ncurc.json",
        ".prettierrc.json",
        "dist",
        "eslint.config.default.js",
        "LICENSE",
        "SECURITY.md",
        "tsconfig.json",
        "tsconfig.scripts.json",
        "vite.config.default.ts",
        "vite.config.tool.ts",
        "vite.config.wasm.ts",
        "vitest.config.ts"
    ],
    "engines": {
        "node": ">=24",
        "npm": ">=12"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=12",
            "onFail": "error"
        }
    },
    "allowScripts": {
        "fsevents@2.3.3": true,
        "unrs-resolver@1.11.1": true
    },
    "scripts": {
        "audit": "node -e \"import('./dist/dpuse-development.es.js').then(m => m.auditDependencies())\"",
        "build": "vite build && node -e \"import('./dist/dpuse-development.es.js').then(m => m.documentAPIReference())\" && node -e \"import('./dist/dpuse-development.es.js').then(m => m.documentBundleSizes())\"",
        "check": "node -e \"import('./dist/dpuse-development.es.js').then(m => m.checkConfigFiles())\" && node -e \"import('./dist/dpuse-development.es.js').then(m => m.checkDependencies())\"",
        "document": "npm run documentOpening && npm run documentUsage && npm run documentDependencies && npm run documentGovernance",
        "documentBundleSizes": "node -e \"import('./dist/dpuse-development.es.js').then(m => m.documentBundleSizes())\"",
        "documentDependencies": "node -e \"import('./dist/dpuse-development.es.js').then(m => m.documentDependencies('Apache-2.0;BSD-3-Clause;MIT'))\"",
        "documentGovernance": "node -e \"import('./dist/dpuse-development.es.js').then(m => m.documentGovernance())\"",
        "documentOpening": "node -e \"import('./dist/dpuse-development.es.js').then(m => m.documentOpening())\"",
        "documentUsage": "node -e \"import('./dist/dpuse-development.es.js').then(m => m.documentUsage())\"",
        "format": "node -e \"import('./dist/dpuse-development.es.js').then(m => m.formatCode())\"",
        "health": "npm run test:coverage && fallow --coverage coverage/coverage-final.json",
        "lint": "node -e \"import('./dist/dpuse-development.es.js').then(m => m.lintCode())\"",
        "release": "npm run sync && gh release create \"v$(npm pkg get version | tr -d '\"')\" --target \"$(git rev-parse HEAD)\" --generate-notes --latest",
        "sync": "node -e \"import('./dist/dpuse-development.es.js').then(m => m.syncProjectWithGitHub())\"",
        "test": "node -e \"import('./dist/dpuse-development.es.js').then(m => m.testProject())\"",
        "test:coverage": "node -e \"import('./dist/dpuse-development.es.js').then(m => m.testProject(['unit'], true))\""
    },
    "peerDependencies": {
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@dpuse/dpuse-shared": "^0.3.851",
        "acorn": "^8.18.0",
        "acorn-typescript": "^1.4.13",
        "license-checker-rseidelsohn": "^5.0.1",
        "npm-check-updates": "^23.1.0",
        "valibot": "^1.5.0"
    },
    "devDependencies": {
        "@dpuse/eslint-config-dpuse": "^1.0.123",
        "@types/node": "^26.6.3",
        "@vitest/coverage-v8": "^5.0.2",
        "eslint": "^10.11.0",
        "fallow": "^3.30.0",
        "fast-check": "^4.10.2",
        "prettier": "^3.9.9",
        "sonda": "^0.14.0",
        "type-fest": "^5.10.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.1",
        "vite-plugin-dts": "^5.1.1",
        "vite-plugin-wasm": "^3.6.0",
        "vitest": "^5.0.2"
    }
}